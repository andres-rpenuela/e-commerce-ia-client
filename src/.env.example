# ==============================================================================
# 📝 ARCHIVO DE CONFIGURACIÓN DE EJEMPLO (.env.example)
# Instrucciones: Copia este archivo y renombralo según el entorno que vayas a usar:
#   👉 .env.development   (Para desarrollo local en tu máquina)
#   👉 .env.preproduction  (Para el servidor de pruebas/staging)
#   👉 .env.production   (Para el servidor real en vivo)
# ==============================================================================

# 🐋 COMANDOS RÁPIDOS CON DOCKER (Recomendado - No requiere instalar nada)
# ------------------------------------------------------------------------------
# • Programar en Local (Con Live Reload):  docker compose up frontend-local
# • Probar Pre-producción en Nginx:        docker compose up --build frontend-pre
# • Probar Producción en Nginx:          docker compose up --build frontend-pro
# • Apagar y limpiar contenedores:        docker compose down
# ------------------------------------------------------------------------------

# 📦 COMANDOS NATIVOS CON NPM (Requiere Node 24+ instalado en tu máquina)
# ------------------------------------------------------------------------------
# • Programar en Local (Dev):              npm run dev
# • Levantar Pre-producción Local:         npm run pre
# • Levantar Producción Local:             npm run pro
# • Ejecutar Pruebas de una vez (CI):      npm run test:ci
# • Compilar el proyecto para Pruebas:     npm run build:pre
# • Compilar el proyecto para Producción:  npm run build:prod
# ------------------------------------------------------------------------------

# 🌐 URLs de los Servidores API correspondientes
NG_APP_API_URL=

# 💳 Claves públicas para pasarelas de pago (Stripe)
NG_APP_STRIPE_PUBLIC_KEY=

# 🔥 Configuración de Firebase / Autenticación
NG_APP_FIREBASE_API_KEY=
NG_APP_FIREBASE_AUTH_DOMAIN=

# 👤 Identificadores de Entorno Obligatorios (Leídos por Angular)
NG_APP_ENV=          # Valores válidos: local | preproduction | production
NG_APP_ENV_NAME=     # Valores visuales: Desarrollo | Pre-producción | Producción
